# Copy this file to .env for local use. The application loads .env with override=False.
REVIEW_AGENT_RUNTIME_ROOT=D:\demo-runtime
REVIEW_AGENT_HOST=127.0.0.1
REVIEW_AGENT_PORT=8000
REVIEW_AGENT_MAX_UPLOAD_BYTES=10485760
REVIEW_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:8000
REVIEW_AGENT_LLM_MODE=openai_compatible
REVIEW_AGENT_LLM_BASE_URL=https://api.deepseek.com
REVIEW_AGENT_LLM_API_KEY=
REVIEW_AGENT_LLM_MODEL=deepseek-v4-pro
REVIEW_AGENT_LLM_TIMEOUT_SECONDS=60
REVIEW_AGENT_LLM_CONTEXT_BUDGET_TOKENS=6000
REVIEW_AGENT_LLM_PROMPT_COST_PER_1M=
REVIEW_AGENT_LLM_COMPLETION_COST_PER_1M=
REVIEW_AGENT_EMBEDDING_MODE=openai_compatible
REVIEW_AGENT_EMBEDDING_BASE_URL=
REVIEW_AGENT_EMBEDDING_API_KEY=
REVIEW_AGENT_EMBEDDING_MODEL=
REVIEW_AGENT_EMBEDDING_TIMEOUT_SECONDS=60
REVIEW_AGENT_BGE_CACHE_DIR=D:\demo-runtime\models\huggingface
REVIEW_AGENT_BGE_DEVICE=cpu
REVIEW_AGENT_BGE_EMBEDDING_MODEL=BAAI/bge-m3
REVIEW_AGENT_BGE_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
REVIEW_AGENT_BGE_EMBEDDING_MAX_LENGTH=1024
REVIEW_AGENT_BGE_EMBEDDING_BATCH_SIZE=8
REVIEW_AGENT_BGE_RERANKER_MODEL=BAAI/bge-reranker-base
REVIEW_AGENT_BGE_RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
REVIEW_AGENT_BGE_RERANKER_MAX_LENGTH=512
REVIEW_AGENT_BGE_RERANKER_BATCH_SIZE=8
REVIEW_AGENT_DOCLING_ARTIFACTS_PATH=D:\demo-runtime\models\docling
REVIEW_AGENT_DOCLING_DOCUMENT_TIMEOUT_SECONDS=300
REVIEW_AGENT_DOCLING_LAYOUT_REVISION=8f39ad3c0b4c58e9c2d2c84a38465abf757272d8
REVIEW_AGENT_DOCLING_TABLE_REVISION=v2.3.0
REVIEW_AGENT_DOCLING_DEVICE=cpu
REVIEW_AGENT_EMBEDDING_CACHE_TTL_SECONDS=604800
REVIEW_AGENT_RETRIEVAL_CACHE_TTL_SECONDS=3600
REVIEW_AGENT_NODE_TIMEOUT_SECONDS=90
REVIEW_AGENT_LLM_MAX_CONCURRENCY=2
REVIEW_AGENT_MEMORY_DB_PATH=D:\demo-runtime\data\review_agent_memory.sqlite3
REVIEW_AGENT_UPLOAD_DIR=D:\demo-runtime\data\uploads
REVIEW_AGENT_RUNTIME_LOG_FILE=D:\demo-runtime\logs\review_agent.log
REVIEW_AGENT_RUNTIME_LOG_LEVEL=INFO
REVIEW_AGENT_REPORT_DIR=D:\demo-runtime\data\reports
REVIEW_AGENT_EVALUATION_OUTPUT_DIR=D:\demo-runtime\data\evaluation
PLAYWRIGHT_BASE_URL=http://127.0.0.1:8010
REVIEW_AGENT_E2E_PORT=8010

# Agent framework migration. The current application keeps using SQLite until
# the direct cutover task; this URL is used by Alembic and the migration CLI.
REVIEW_AGENT_DATABASE_URL=postgresql+psycopg://review_agent:change-me@127.0.0.1:5432/review_agent
REVIEW_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
REVIEW_AGENT_RQ_QUEUE=review-agent
REVIEW_AGENT_RQ_JOB_TIMEOUT_SECONDS=7200
REVIEW_AGENT_RQ_STATUS_RESERVE_SECONDS=120

# MCP is absent unless explicitly enabled. It can only run with the API bound
# to 127.0.0.1 and excludes parse_document, write_memory and generate_report.
REVIEW_AGENT_MCP_ENABLED=false

# Optional OTLP tracing. Tool spans contain identifiers, status and timing only;
# contract text, prompts, evidence, Memory content and credentials are excluded.
REVIEW_AGENT_OBSERVABILITY_ENABLED=false
REVIEW_AGENT_OTEL_SERVICE_NAME=contract-review-agent
REVIEW_AGENT_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
REVIEW_AGENT_OTEL_EXPORTER_OTLP_HEADERS=
REVIEW_AGENT_OTEL_EXPORT_TIMEOUT_SECONDS=10

# Langfuse can use its native OTLP endpoint:
# https://<langfuse-host>/api/public/otel/v1/traces
# Provide the documented Basic authorization and ingestion-version headers in
# REVIEW_AGENT_OTEL_EXPORTER_OTLP_HEADERS; never commit their values.
